rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isInstructor() {
      return signedIn() && userData().role == 'instructor';
    }

    function isInstructorAfter() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.role == 'instructor';
    }

    function ownerExists() {
      return exists(/databases/$(database)/documents/system/owner);
    }

    function ownerAfterMatchesUser() {
      return getAfter(/databases/$(database)/documents/system/owner).data.uid == uid();
    }

    function courseOwner(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == uid();
    }

    function sectionOwner(sectionId) {
      return signedIn()
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionOwnerAfter(sectionId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionMember(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function sectionMemberAfter(sectionId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function assessmentData(assessmentId) {
      return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
    }

    function assessmentOwner(assessmentId) {
      return signedIn() && assessmentData(assessmentId).ownerId == uid();
    }

    function assessmentMember(assessmentId) {
      return signedIn()
        && assessmentData(assessmentId).sectionId != ''
        && sectionMember(assessmentData(assessmentId).sectionId);
    }

    function assessmentOpen(assessmentId) {
      return assessmentMember(assessmentId)
        && assessmentData(assessmentId).status == 'Published'
        && (
          assessmentData(assessmentId).opensAt == null
          || request.time >= assessmentData(assessmentId).opensAt
        )
        && (
          assessmentData(assessmentId).closesAt == null
          || request.time <= assessmentData(assessmentId).closesAt
        );
    }

    function hasActiveSubmission(assessmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
        && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress';
    }

    function gradingSelectionOpen(sectionId) {
      return sectionMember(sectionId)
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionOpen == true
        && (
          get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline == null
          || request.time <= get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline
        );
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && (
          request.resource.data.role == 'student'
          || (
            request.resource.data.role == 'instructor'
            && request.resource.data.bootstrapOwner == true
            && !ownerExists()
            && ownerAfterMatchesUser()
          )
        );
      allow read: if isSelf(userId);
      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /enrollments/{sectionId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId) && sectionMemberAfter(sectionId);
      }
    }

    match /system/{systemDoc} {
      allow read: if signedIn();
      allow create: if systemDoc == 'owner'
        && !ownerExists()
        && isInstructorAfter()
        && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid();
      allow update: if courseOwner(courseId)
        || (
          isInstructor()
          && !('ownerId' in resource.data)
          && request.resource.data.ownerId == uid()
        );
      allow delete: if courseOwner(courseId);

      match /units/{unitId} {
        allow read: if signedIn();
        allow create, update, delete: if courseOwner(courseId);

        match /topics/{topicId} {
          allow read: if signedIn();
          allow create, update, delete: if courseOwner(courseId);
        }
      }

      match /competencies/{competencyId} {
        allow read: if signedIn();
        allow create, update, delete: if courseOwner(courseId);
      }

      match /items/{itemId} {
        allow read, create, update, delete: if courseOwner(courseId);
      }
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid();
      allow update, delete: if sectionOwner(sectionId);

      match /members/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.userId == uid()
          && request.resource.data.role == 'student'
          && get(/databases/$(database)/documents/sections/$(sectionId)).data.joinOpen == true;
        allow update: if sectionOwner(sectionId);
        allow delete: if sectionOwner(sectionId) || isSelf(userId);
      }

      match /assignments/{assignmentId} {
        allow read: if sectionOwner(sectionId)
          || (sectionMember(sectionId) && resource.data.status == 'Published');
        allow create, update, delete: if sectionOwner(sectionId);

        match /submissions/{studentId} {
          allow read: if sectionOwner(sectionId) || isSelf(studentId);
          allow create: if isSelf(studentId)
            && sectionMember(sectionId)
            && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
            && request.resource.data.studentId == uid()
            && request.resource.data.status in ['draft', 'submitted'];
          allow update: if sectionOwner(sectionId)
            || (
              isSelf(studentId)
              && sectionMember(sectionId)
              && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
              && request.resource.data.studentId == uid()
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.status in ['draft', 'submitted']
              && (
                resource.data.status == 'draft'
                || get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.allowResubmission == true
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'responseText',
                'responseUrl',
                'status',
                'submittedAt',
                'updatedAt',
                'studentName'
              ])
            );
          allow delete: if sectionOwner(sectionId)
            || (
              isSelf(studentId)
              && resource.data.status == 'draft'
            );
        }
      }

      match /resources/{resourceId} {
        allow read: if sectionOwner(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /grades/{gradeId} {
        allow read: if sectionOwner(sectionId)
          || (sectionMember(sectionId) && resource.data.studentId == uid());
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /assessmentRefs/{assessmentId} {
        allow read: if sectionOwner(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /gradingPathways/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId);
        allow create, update: if sectionOwner(sectionId)
          || (
            isSelf(userId)
            && gradingSelectionOpen(sectionId)
            && request.resource.data.studentId == uid()
            && request.resource.data.pathway in ['examination', 'composite']
          );
        allow delete: if sectionOwner(sectionId);
      }

      match /assessmentGrades/{gradeId} {
        allow read: if sectionOwner(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /mastery/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /academicRecords/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /portfolios/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /appeals/{appealId} {
        allow read: if sectionOwner(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create: if sectionMember(sectionId)
          && request.resource.data.studentId == uid()
          && request.resource.data.status == 'Pending';
        allow update, delete: if sectionOwner(sectionId);
      }

      match /recordHistory/{historyId} {
        allow read: if sectionOwner(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create: if sectionOwner(sectionId);
        allow update, delete: if false;
      }
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && sectionOwnerAfter(request.resource.data.sectionId);
      allow update: if isInstructor()
        && sectionOwner(resource.data.sectionId)
        && request.resource.data.sectionId == resource.data.sectionId;
      allow delete: if isInstructor()
        && sectionOwner(resource.data.sectionId);
    }

    match /assessments/{assessmentId} {
      allow read: if (
          signedIn()
          && resource.data.ownerId == uid()
        )
        || (
          signedIn()
          && resource.data.sectionId != ''
          && exists(/databases/$(database)/documents/sections/$(resource.data.sectionId)/members/$(uid()))
          && resource.data.status in ['Published', 'Closed']
        );
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && courseOwner(request.resource.data.courseId)
        && (
          request.resource.data.sectionId == ''
          || sectionOwner(request.resource.data.sectionId)
        );
      allow update: if assessmentOwner(assessmentId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.courseId == resource.data.courseId
        && (
          request.resource.data.sectionId == resource.data.sectionId
          || request.resource.data.sectionId == ''
          || sectionOwner(request.resource.data.sectionId)
        );
      allow delete: if assessmentOwner(assessmentId);

      match /questions/{questionId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            signedIn()
            && assessmentData(assessmentId).sectionId != ''
            && sectionMember(assessmentData(assessmentId).sectionId)
            && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
            && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress'
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }

      match /keys/{questionId} {
        allow read, create, update, delete: if assessmentOwner(assessmentId);
      }

      match /submissions/{studentId} {
        allow read: if assessmentOwner(assessmentId) || isSelf(studentId);

        allow create: if assessmentOwner(assessmentId)
          || (
            isSelf(studentId)
            && assessmentOpen(assessmentId)
            && request.resource.data.studentId == uid()
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasOnly([
              'studentId',
              'candidateNumber',
              'status',
              'startedAt',
              'updatedAt',
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'questionOrder',
              'acknowledgedAt',
              'accommodationsApplied'
            ])
          );

        allow update: if assessmentOwner(assessmentId)
          || (
            isSelf(studentId)
            && assessmentMember(assessmentId)
            && resource.data.status == 'in_progress'
            && request.resource.data.studentId == uid()
            && request.resource.data.candidateNumber == resource.data.candidateNumber
            && request.resource.data.status in ['in_progress', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'status',
              'submittedAt',
              'updatedAt'
            ])
          );

        allow delete: if assessmentOwner(assessmentId);

        match /events/{eventId} {
          allow read: if assessmentOwner(assessmentId) || isSelf(studentId);
          allow create: if isSelf(studentId)
            && assessmentMember(assessmentId)
            && request.resource.data.studentId == uid();
          allow update: if false;
          allow delete: if assessmentOwner(assessmentId);
        }
      }

      match /results/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            isSelf(studentId)
            && resource.data.complete == true
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
