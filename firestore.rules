rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isInstructor() {
      return signedIn() && userData().role == 'instructor';
    }

    function isSystemOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.uid == uid()
        && get(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function ownerRecordMatchesUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.uid == uid();
    }

    function ownerEmailMatchesUser() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.email == request.auth.token.email;
    }

    function claimingSystemOwner() {
      return signedIn()
        && !ownerExists()
        && existsAfter(/databases/$(database)/documents/system/owner)
        && getAfter(/databases/$(database)/documents/system/owner).data.uid == uid()
        && getAfter(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function reclaimingSystemOwner() {
      return ownerEmailMatchesUser()
        && existsAfter(/databases/$(database)/documents/system/owner)
        && getAfter(/databases/$(database)/documents/system/owner).data.uid == uid()
        && getAfter(/databases/$(database)/documents/system/owner).data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function courseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function courseIsPublishedCatalog(courseId) {
      return ('catalogCourse' in courseData(courseId))
        && ('catalogPublished' in courseData(courseId))
        && courseData(courseId).catalogCourse == true
        && courseData(courseId).catalogPublished == true;
    }

    function canUseCourseAsInstructor(courseId) {
      return isInstructor()
        && (
          courseOwner(courseId)
          || isSystemOwner()
          || courseIsPublishedCatalog(courseId)
        );
    }

    function canManageCourse(courseId) {
      return isSystemOwner()
        || courseCoordinator(courseId)
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in courseData(courseId))
            || courseData(courseId).catalogCourse != true
          )
        );
    }

    function isInstructorAfter() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.role == 'instructor';
    }

    function ownerExists() {
      return exists(/databases/$(database)/documents/system/owner);
    }

    function ownerAfterMatchesUser() {
      return getAfter(/databases/$(database)/documents/system/owner).data.uid == uid();
    }

    function courseOwner(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == uid();
    }

    function courseCoordinator(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId)/staff/$(uid()))
        && get(/databases/$(database)/documents/courses/$(courseId)/staff/$(uid())).data.role == 'coordinator';
    }

    function sectionOwner(sectionId) {
      return signedIn()
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionOwnerAfter(sectionId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionStaff(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/staff/$(uid()));
    }

    function sectionStaffRole(sectionId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)/staff/$(uid())).data.role;
    }

    function sectionAcademicManager(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) == 'coordinator'
        );
    }

    function sectionCourseworkManager(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) in ['coordinator', 'teaching_assistant']
        );
    }

    function sectionGrader(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) in ['coordinator', 'teaching_assistant', 'grader']
        );
    }

    function sectionMember(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function sectionMemberAfter(sectionId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function sectionData(sectionId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)).data;
    }

    function sectionRequiresEntranceExam(sectionId) {
      return (
          ('entranceExamRequired' in sectionData(sectionId))
          && sectionData(sectionId).entranceExamRequired == true
        )
        || (
          ('entranceExamRequired' in courseData(sectionData(sectionId).courseId))
          && courseData(sectionData(sectionId).courseId).entranceExamRequired == true
        );
    }

    function entranceCandidate(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid()));
    }

    function entranceCandidatePassed(sectionId) {
      return entranceCandidate(sectionId)
        && get(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid())).data.status == 'passed'
        && get(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid())).data.assessmentId == sectionData(sectionId).entranceAssessmentId;
    }

    function assessmentData(assessmentId) {
      return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
    }

    function assessmentOwner(assessmentId) {
      return signedIn() && assessmentData(assessmentId).ownerId == uid();
    }

    function assessmentEntranceCandidate(assessmentId) {
      return signedIn()
        && ('entranceExam' in assessmentData(assessmentId))
        && assessmentData(assessmentId).entranceExam == true
        && assessmentData(assessmentId).sectionId != ''
        && ('entranceAssessmentId' in sectionData(assessmentData(assessmentId).sectionId))
        && sectionData(assessmentData(assessmentId).sectionId).entranceAssessmentId == assessmentId
        && entranceCandidate(assessmentData(assessmentId).sectionId);
    }

    function assessmentMember(assessmentId) {
      return signedIn()
        && assessmentData(assessmentId).sectionId != ''
        && (
          sectionMember(assessmentData(assessmentId).sectionId)
          || assessmentEntranceCandidate(assessmentId)
        );
    }

    function activeRetakeAuthorization(assessmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid()))
        && get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.active == true;
    }

    function retakeWindowOpen(assessmentId) {
      return activeRetakeAuthorization(assessmentId)
        && (
          !('opensAt' in get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data)
          || get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.opensAt == null
          || request.time >= get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.opensAt
        )
        && (
          !('closesAt' in get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data)
          || get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.closesAt == null
          || request.time <= get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.closesAt
        );
    }

    function assessmentOpen(assessmentId) {
      return assessmentMember(assessmentId)
        && (
          (
            assessmentData(assessmentId).status == 'Published'
            && (
              (
                (
                  assessmentData(assessmentId).opensAt == null
                  || request.time >= assessmentData(assessmentId).opensAt
                )
                && (
                  assessmentData(assessmentId).closesAt == null
                  || request.time <= assessmentData(assessmentId).closesAt
                )
              )
              || (
                ('makeupOpensAt' in assessmentData(assessmentId))
                && ('makeupClosesAt' in assessmentData(assessmentId))
                && assessmentData(assessmentId).makeupOpensAt != null
                && assessmentData(assessmentId).makeupClosesAt != null
                && request.time >= assessmentData(assessmentId).makeupOpensAt
                && request.time <= assessmentData(assessmentId).makeupClosesAt
                && (
                  !('makeupStudentIds' in assessmentData(assessmentId))
                  || assessmentData(assessmentId).makeupStudentIds.size() == 0
                  || uid() in assessmentData(assessmentId).makeupStudentIds
                )
              )
            )
          )
          || retakeWindowOpen(assessmentId)
        );
    }

    function hasActiveSubmission(assessmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
        && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress';
    }

    function assessmentRequiresAccessCode(assessmentId) {
      return ('securityPolicy' in assessmentData(assessmentId))
        && ('accessCodeConfigured' in assessmentData(assessmentId).securityPolicy)
        && assessmentData(assessmentId).securityPolicy.accessCodeConfigured == true;
    }

    function assessmentAccessAuthorized(assessmentId) {
      return !assessmentRequiresAccessCode(assessmentId)
        || (
          exists(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config)
          && exists(/databases/$(database)/documents/assessments/$(assessmentId)/accessAuthorizations/$(uid()))
          && get(/databases/$(database)/documents/assessments/$(assessmentId)/accessAuthorizations/$(uid())).data.version
            == get(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config).data.version
          && get(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config).data.version
            == assessmentData(assessmentId).securityPolicy.accessCodeVersion
        );
    }

    function assessmentAttemptCountAllowed(assessmentId, count) {
      return (
          (
            (
              !('securityPolicy' in assessmentData(assessmentId))
              || !('maxAttempts' in assessmentData(assessmentId).securityPolicy)
            )
            && count <= 1
          )
          || (
            ('securityPolicy' in assessmentData(assessmentId))
            && ('maxAttempts' in assessmentData(assessmentId).securityPolicy)
            && count <= assessmentData(assessmentId).securityPolicy.maxAttempts
          )
        )
        || (
          activeRetakeAuthorization(assessmentId)
          && get(/databases/$(database)/documents/assessments/$(assessmentId)/retakes/$(uid())).data.authorizedAttemptNumber == count
        );
    }

    function assessmentLateEntryAllowed(assessmentId) {
      return retakeWindowOpen(assessmentId)
        || !('securityPolicy' in assessmentData(assessmentId))
        || !('lateEntryPolicy' in assessmentData(assessmentId).securityPolicy)
        || assessmentData(assessmentId).securityPolicy.lateEntryPolicy != 'deny-after-start'
        || assessmentData(assessmentId).opensAt == null
        || (
          ('lateEntryGraceMinutes' in assessmentData(assessmentId).securityPolicy)
          && request.time <= assessmentData(assessmentId).opensAt
            + duration.value(int(assessmentData(assessmentId).securityPolicy.lateEntryGraceMinutes), 'm')
        );
    }

    function assessmentHonorSatisfied(assessmentId) {
      return !('securityPolicy' in assessmentData(assessmentId))
        || !('honorAcknowledgement' in assessmentData(assessmentId).securityPolicy)
        || assessmentData(assessmentId).securityPolicy.honorAcknowledgement != true
        || (
          ('honorAcknowledged' in request.resource.data)
          && request.resource.data.honorAcknowledged == true
        );
    }

    function gradingSelectionOpen(sectionId) {
      return sectionMember(sectionId)
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionOpen == true
        && (
          get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline == null
          || request.time <= get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline
        );
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.role in ['student', 'instructor', 'parent'];
      allow read: if isSelf(userId) || isSystemOwner();
      allow update: if isSelf(userId)
        && (
          request.resource.data.role == resource.data.role
          || (
            request.resource.data.role == 'instructor'
            && (
              ownerRecordMatchesUser()
              || claimingSystemOwner()
              || reclaimingSystemOwner()
            )
          )
        );
      allow delete: if false;

      match /enrollments/{sectionId} {
        allow read: if isSelf(userId);
        allow delete: if isSelf(userId) || sectionOwner(sectionId);
        allow create: if isSelf(userId) && sectionMemberAfter(sectionId);
        allow update: if (
          isSelf(userId) && sectionMemberAfter(sectionId)
        ) || sectionOwner(sectionId);
      }

      match /staffSections/{sectionId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /entranceAttempts/{sectionId} {
        allow read: if isSelf(userId) || sectionGrader(sectionId);
        allow create, update: if isSelf(userId) || sectionGrader(sectionId);
        allow delete: if isSelf(userId) || sectionAcademicManager(sectionId);
      }

      match /notifications/{notificationId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /announcementAcks/{announcementId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /directory/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == uid();
      allow delete: if isSelf(userId);
    }

    match /academicAccess/{userId} {
      allow read: if isSelf(userId) || isInstructor();
      allow create, update: if isInstructor()
        && request.resource.data.studentId == userId;
      allow delete: if isSystemOwner();
    }

    match /system/{systemDoc} {
      allow read: if signedIn();
      allow create: if (
          systemDoc in ['platform', 'announcement']
          && isSystemOwner()
        )
        || (
          systemDoc == 'owner'
          && !ownerExists()
          && isInstructorAfter()
          && request.resource.data.uid == uid()
          && request.resource.data.confirmed == true
        );
      allow update: if (
          systemDoc in ['platform', 'announcement']
          && isSystemOwner()
        )
        || (
          systemDoc == 'owner'
          && request.resource.data.confirmed == true
          && (
            (
              ownerRecordMatchesUser()
              && request.resource.data.uid == resource.data.uid
            )
            || (
              ownerEmailMatchesUser()
              && request.resource.data.uid == uid()
              && request.resource.data.email == request.auth.token.email
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid',
            'displayName',
            'email',
            'confirmed',
            'confirmedAt',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && (
          !('catalogCourse' in request.resource.data)
          || request.resource.data.catalogCourse != true
          || isSystemOwner()
        );
      allow update: if isSystemOwner()
        || (
          courseCoordinator(courseId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'code',
            'title',
            'level',
            'discipline',
            'status',
            'description',
            'prerequisitePolicy',
            'entranceExamRequired',
            'updatedAt'
          ])
        )
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in resource.data)
            || resource.data.catalogCourse != true
          )
          && (
            !('catalogCourse' in request.resource.data)
            || request.resource.data.catalogCourse != true
          )
        )
        || (
          isInstructor()
          && !('ownerId' in resource.data)
          && request.resource.data.ownerId == uid()
          && (
            !('catalogCourse' in request.resource.data)
            || request.resource.data.catalogCourse != true
          )
        );
      allow delete: if isSystemOwner()
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in resource.data)
            || resource.data.catalogCourse != true
          )
        );

      match /units/{unitId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageCourse(courseId);

        match /topics/{topicId} {
          allow read: if signedIn();
          allow create, update, delete: if canManageCourse(courseId);
        }
      }

      match /competencies/{competencyId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /items/{itemId} {
        allow read: if canManageCourse(courseId)
          || (
            isInstructor()
            && courseIsPublishedCatalog(courseId)
          );
        allow create, update, delete: if canManageCourse(courseId);

        match /versions/{versionId} {
          allow read: if canManageCourse(courseId)
            || (
              isInstructor()
              && courseIsPublishedCatalog(courseId)
            );
          allow create: if canManageCourse(courseId);
          allow update, delete: if false;
        }
      }

      match /staff/{userId} {
        allow read: if isInstructor();
        allow create, update, delete: if isSystemOwner() || courseOwner(courseId);
      }

      match /approvals/{userId} {
        allow read: if isSelf(userId) || isInstructor();
        allow create, update, delete: if isInstructor();
      }

      match /auditLog/{eventId} {
        allow read: if canManageCourse(courseId);
        allow create: if canManageCourse(courseId);
        allow update, delete: if false;
      }

      match /rubrics/{rubricId} {
        allow read: if canUseCourseAsInstructor(courseId) || courseIsPublishedCatalog(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create: if canManageCourse(courseId);
        allow update, delete: if isSystemOwner();
      }
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && canUseCourseAsInstructor(request.resource.data.courseId);
      allow update, delete: if sectionOwner(sectionId);

      match /members/{userId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || isSelf(userId);
        allow create: if (
            (
              isSelf(userId)
              && request.resource.data.userId == uid()
              && get(/databases/$(database)/documents/sections/$(sectionId)).data.joinOpen == true
              && (
                !sectionRequiresEntranceExam(sectionId)
                || entranceCandidatePassed(sectionId)
              )
            )
            || (
              sectionOwner(sectionId)
              && request.resource.data.userId == userId
            )
          )
          && request.resource.data.role == 'student';
        allow update: if sectionAcademicManager(sectionId);
        allow delete: if sectionAcademicManager(sectionId) || isSelf(userId);
      }

      match /staff/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId) || sectionStaff(sectionId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /enrollmentHistory/{eventId} {
        allow read, create: if sectionOwner(sectionId);
        allow update: if false;
        allow delete: if sectionOwner(sectionId);
      }

      match /auditLog/{eventId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId);
        allow create: if sectionOwner(sectionId) || sectionStaff(sectionId);
        allow update: if false;
        allow delete: if sectionOwner(sectionId);
      }

      match /withdrawalRequests/{studentId} {
        allow read: if sectionAcademicManager(sectionId) || isSelf(studentId);
        allow create: if isSelf(studentId)
          && sectionMember(sectionId)
          && request.resource.data.studentId == uid()
          && request.resource.data.status == 'Pending';
        allow update: if sectionAcademicManager(sectionId)
          || (
            isSelf(studentId)
            && resource.data.studentId == uid()
            && resource.data.status == 'Pending'
            && request.resource.data.studentId == uid()
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'cancelledAt',
              'updatedAt'
            ])
          );
        allow delete: if sectionAcademicManager(sectionId);
      }

      match /entranceCandidates/{userId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || isSelf(userId);
        allow create: if isSelf(userId)
          && sectionData(sectionId).joinOpen == true
          && request.resource.data.userId == uid()
          && request.resource.data.status == 'pending'
          && request.resource.data.assessmentId == sectionData(sectionId).entranceAssessmentId;
        allow update: if sectionAcademicManager(sectionId);
        allow delete: if sectionAcademicManager(sectionId) || isSelf(userId);
      }

      match /assignments/{assignmentId} {
        allow read: if sectionOwner(sectionId)
          || sectionStaff(sectionId)
          || (sectionMember(sectionId) && resource.data.status == 'Published');
        allow create, update, delete: if sectionCourseworkManager(sectionId);

        match /submissions/{studentId} {
          allow read: if sectionGrader(sectionId) || isSelf(studentId);
          allow create: if isSelf(studentId)
            && sectionMember(sectionId)
            && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
            && request.resource.data.studentId == uid()
            && request.resource.data.status in ['draft', 'submitted'];
          allow update: if sectionGrader(sectionId)
            || (
              isSelf(studentId)
              && sectionMember(sectionId)
              && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
              && request.resource.data.studentId == uid()
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.status in ['draft', 'submitted']
              && (
                resource.data.status == 'draft'
                || get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.allowResubmission == true
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'responseText',
                'responseUrl',
                'status',
                'submittedAt',
                'updatedAt',
                'studentName'
              ])
            );
          allow delete: if sectionGrader(sectionId)
            || (
              isSelf(studentId)
              && resource.data.status == 'draft'
            );
        }
      }

      match /resources/{resourceId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /grades/{gradeId} {
        allow read: if sectionGrader(sectionId)
          || (sectionMember(sectionId) && resource.data.studentId == uid());
        allow create, update, delete: if sectionGrader(sectionId);
      }

      match /assessmentRefs/{assessmentId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /gradingPathways/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update: if sectionAcademicManager(sectionId)
          || (
            isSelf(userId)
            && gradingSelectionOpen(sectionId)
            && request.resource.data.studentId == uid()
            && request.resource.data.pathway in ['examination', 'composite']
          );
        allow delete: if sectionAcademicManager(sectionId);
      }

      match /assessmentGrades/{gradeId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionGrader(sectionId);
      }

      match /mastery/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /academicRecords/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /portfolios/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /appeals/{appealId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create: if sectionMember(sectionId)
          && request.resource.data.studentId == uid()
          && request.resource.data.status == 'Pending';
        allow update, delete: if sectionAcademicManager(sectionId);
      }

      match /recordHistory/{historyId} {
        allow read: if sectionGrader(sectionId)
          || (
            signedIn()
            && resource.data.studentId == uid()
          );
        allow create: if sectionAcademicManager(sectionId);
        allow update: if false;
        allow delete: if sectionAcademicManager(sectionId);
      }

      match /events/{eventId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /announcements/{announcementId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /attendance/{attendanceId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /extensions/{extensionId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /groups/{groupId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /groupAssignments/{groupAssignmentId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /flags/{flagId} {
        allow read: if sectionGrader(sectionId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /narratives/{userId} {
        allow read: if sectionGrader(sectionId)
          || (
            isSelf(userId)
            && resource.data.includeOnRecord == true
          );
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /recognitions/{recognitionId} {
        allow read: if sectionGrader(sectionId)
          || (
            signedIn()
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && sectionOwnerAfter(request.resource.data.sectionId);
      allow update: if isInstructor()
        && sectionOwner(resource.data.sectionId)
        && request.resource.data.sectionId == resource.data.sectionId;
      allow delete: if isInstructor()
        && sectionOwner(resource.data.sectionId);
    }

    match /assessments/{assessmentId} {
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.ownerId == uid()
        )
        || (
          signedIn()
          && resource.data.sectionId != ''
          && (
            sectionOwner(resource.data.sectionId)
            || sectionStaff(resource.data.sectionId)
          )
        )
        || (
          signedIn()
          && resource.data.sectionId != ''
          && (
            exists(/databases/$(database)/documents/sections/$(resource.data.sectionId)/members/$(uid()))
            || assessmentEntranceCandidate(assessmentId)
          )
          && resource.data.status in ['Published', 'Closed']
        );
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && canUseCourseAsInstructor(request.resource.data.courseId)
        && (
          request.resource.data.sectionId == ''
          || sectionCourseworkManager(request.resource.data.sectionId)
        );
      allow update: if (
          assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionCourseworkManager(assessmentData(assessmentId).sectionId)
          )
        )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.sectionId == resource.data.sectionId;
      allow delete: if assessmentOwner(assessmentId)
        || (
          assessmentData(assessmentId).sectionId != ''
          && sectionAcademicManager(assessmentData(assessmentId).sectionId)
        );

      match /questions/{questionId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            signedIn()
            && assessmentData(assessmentId).sectionId != ''
            && assessmentMember(assessmentId)
            && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
            && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress'
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }

      match /keys/{questionId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }

      match /securityPrivate/{securityDoc} {
        allow read, create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /accessAuthorizations/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
        allow create, update: if isSelf(studentId)
          && assessmentOpen(assessmentId)
          && assessmentRequiresAccessCode(assessmentId)
          && exists(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config)
          && request.resource.data.keys().hasOnly([
            'studentId',
            'accessCode',
            'version',
            'authorizedAt',
            'updatedAt'
          ])
          && request.resource.data.studentId == uid()
          && request.resource.data.accessCode
            == get(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config).data.accessCode
          && request.resource.data.version
            == get(/databases/$(database)/documents/assessments/$(assessmentId)/securityPrivate/config).data.version
          && request.resource.data.version
            == assessmentData(assessmentId).securityPolicy.accessCodeVersion;
        allow delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /retakes/{studentId} {
        allow read: if isSelf(studentId)
          || assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /attemptHistory/{historyId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            signedIn()
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /attemptSubmissions/{historyId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            signedIn()
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /attemptResults/{historyId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            signedIn()
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /submissions/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || isSelf(studentId);

        allow create: if assessmentOwner(assessmentId)
          || (
            isSelf(studentId)
            && assessmentOpen(assessmentId)
            && assessmentLateEntryAllowed(assessmentId)
            && assessmentAccessAuthorized(assessmentId)
            && request.resource.data.studentId == uid()
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasOnly([
              'studentId',
              'candidateNumber',
              'status',
              'startedAt',
              'updatedAt',
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'questionOrder',
              'acknowledgedAt',
              'honorAcknowledged',
              'securityPolicySnapshot',
              'securityViolationCount',
              'accommodationsApplied',
              'attemptNumber'
            ])
            && assessmentHonorSatisfied(assessmentId)
            && request.resource.data.securityViolationCount == 0
            && existsAfter(/databases/$(database)/documents/assessments/$(assessmentId)/attemptCounters/$(uid()))
            && getAfter(/databases/$(database)/documents/assessments/$(assessmentId)/attemptCounters/$(uid())).data.count
              == request.resource.data.attemptNumber
            && assessmentAttemptCountAllowed(assessmentId, request.resource.data.attemptNumber)
          );

        allow update: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            isSelf(studentId)
            && assessmentMember(assessmentId)
            && resource.data.status == 'in_progress'
            && request.resource.data.studentId == uid()
            && request.resource.data.candidateNumber == resource.data.candidateNumber
            && request.resource.data.status in ['in_progress', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'status',
              'submittedAt',
              'updatedAt',
              'securityViolationCount'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['securityViolationCount'])
              || (
                (
                  !('securityViolationCount' in resource.data)
                  && request.resource.data.securityViolationCount == 1
                )
                || (
                  ('securityViolationCount' in resource.data)
                  && request.resource.data.securityViolationCount == resource.data.securityViolationCount + 1
                )
              )
            )
          );

        allow delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );

        match /events/{eventId} {
          allow read: if assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionGrader(assessmentData(assessmentId).sectionId)
            )
            || isSelf(studentId);
          allow create: if isSelf(studentId)
            && assessmentMember(assessmentId)
            && request.resource.data.studentId == uid();
          allow update: if false;
          allow delete: if assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionAcademicManager(assessmentData(assessmentId).sectionId)
            );
        }
      }

      match /reviewReflections/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || isSelf(studentId);
        allow create, update: if isSelf(studentId)
          && assessmentMember(assessmentId)
          && request.resource.data.studentId == uid()
          && exists(/databases/$(database)/documents/assessments/$(assessmentId)/results/$(uid()))
          && get(/databases/$(database)/documents/assessments/$(assessmentId)/results/$(uid())).data.complete == true;
        allow delete: if isSelf(studentId)
          || assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }

      match /results/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            isSelf(studentId)
            && resource.data.complete == true
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
      }

      match /attemptCounters/{studentId} {
        allow read: if isSelf(studentId)
          || assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
        allow create: if (
            assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionAcademicManager(assessmentData(assessmentId).sectionId)
            )
          )
          || (
            isSelf(studentId)
            && assessmentOpen(assessmentId)
            && assessmentLateEntryAllowed(assessmentId)
            && assessmentAccessAuthorized(assessmentId)
            && request.resource.data.keys().hasOnly([
              'studentId',
              'count',
              'lastStartedAt',
              'updatedAt'
            ])
            && request.resource.data.studentId == uid()
            && request.resource.data.count is int
            && request.resource.data.count == 1
            && assessmentAttemptCountAllowed(assessmentId, request.resource.data.count)
          );
        allow update: if (
            assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionAcademicManager(assessmentData(assessmentId).sectionId)
            )
          )
          || (
            isSelf(studentId)
            && assessmentOpen(assessmentId)
            && assessmentLateEntryAllowed(assessmentId)
            && assessmentAccessAuthorized(assessmentId)
            && request.resource.data.keys().hasOnly([
              'studentId',
              'count',
              'lastStartedAt',
              'updatedAt'
            ])
            && request.resource.data.studentId == uid()
            && request.resource.data.count is int
            && request.resource.data.count == resource.data.count + 1
            && assessmentAttemptCountAllowed(assessmentId, request.resource.data.count)
          );
        allow delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );
      }
    }


    // Institution catalog: independent educator data is intentionally unchanged.
    function institutionOwner(instId) {
      return signedIn()
        && exists(/databases/$(database)/documents/institutions/$(instId))
        && get(/databases/$(database)/documents/institutions/$(instId)).data.ownerUid == uid();
    }

    function institutionAdmin(instId) {
      return institutionOwner(instId)
        || (signedIn()
          && exists(/databases/$(database)/documents/institutions/$(instId)/staff/$(uid()))
          && get(/databases/$(database)/documents/institutions/$(instId)/staff/$(uid())).data.role
            in ['principal','assistant_principal','district_admin','registrar']);
    }

    match /institutions/{instId} {
      allow read: if signedIn() && (resource.data.status == 'active' || resource.data.ownerUid == uid());
      allow create: if isInstructor()
        && request.resource.data.keys().hasOnly(['name','kind','description','parentDistrictId','ownerUid','status','verified','createdAt'])
        && request.resource.data.ownerUid == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 750
        && request.resource.data.kind in ['school','district']
        && request.resource.data.status == 'active'
        && request.resource.data.verified == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.parentDistrictId is string
        && (
          request.resource.data.parentDistrictId == ''
          || (
            request.resource.data.kind == 'school'
            && institutionOwner(request.resource.data.parentDistrictId)
            && get(/databases/$(database)/documents/institutions/$(request.resource.data.parentDistrictId)).data.kind == 'district'
          )
        );
      allow update, delete: if false;

      match /members/{studentUid} {
        allow get: if institutionAdmin(instId) || isSelf(studentUid);
        allow list: if institutionAdmin(instId);
        allow create: if isSelf(studentUid)
          && userData().role == 'student'
          && get(/databases/$(database)/documents/institutions/$(instId)).data.kind in ['school','district']
          && request.resource.data.keys().hasOnly(['studentUid','studentName','status','requestedAt'])
          && request.resource.data.studentUid == uid()
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time;
        allow update: if institutionAdmin(instId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['active','declined']
          && request.resource.data.reviewedBy == uid()
          && request.resource.data.reviewedAt == request.time;
        allow delete: if false;
      }

      match /placements/{placementId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid()) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','offeringId','sectionReference','status','approvedRequestId','placedBy','placedAt'])
          && request.resource.data.placedBy == uid()
          && request.resource.data.placedAt == request.time
          && request.resource.data.status == 'placed'
          && placementId == request.resource.data.approvedRequestId
          && exists(/databases/$(database)/documents/institutions/$(instId)/requests/$(placementId))
          && get(/databases/$(database)/documents/institutions/$(instId)/requests/$(placementId)).data.status == 'approved'
          && request.resource.data.studentUid == get(/databases/$(database)/documents/institutions/$(instId)/requests/$(placementId)).data.studentUid
          && request.resource.data.offeringId == get(/databases/$(database)/documents/institutions/$(instId)/requests/$(placementId)).data.offeringId;
        allow update, delete: if false;
      }
      match /studentRecords/{recordId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid()) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','courseTitle','credits','finalGrade','status','recordedBy','recordedAt'])
          && request.resource.data.recordedBy == uid()
          && request.resource.data.recordedAt == request.time
          && request.resource.data.studentUid is string
          && request.resource.data.credits is number
          && request.resource.data.credits >= 0 && request.resource.data.credits <= 50
          && request.resource.data.status in ['pending','certified','withdrawn'];
        allow update, delete: if false;
      }
      match /attendance/{attendanceId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid()) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','offeringTitle','day','status','recordedBy','recordedAt'])
          && request.resource.data.recordedBy == uid() && request.resource.data.recordedAt == request.time
          && request.resource.data.status in ['present','absent','late','excused'];
        allow update, delete: if false;
      }
      match /graduationPolicies/{policyId} {
        allow read: if signedIn();
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['name','requiredCredits','description','createdBy','createdAt'])
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && request.resource.data.requiredCredits is number
          && request.resource.data.requiredCredits >= 0 && request.resource.data.requiredCredits <= 1000;
        allow update, delete: if false;
      }
      function guardianApproved(studentId) {
        return signedIn()
          && exists(/databases/$(database)/documents/institutions/$(instId)/guardianAccess/$(uid() + '_' + studentId))
          && get(/databases/$(database)/documents/institutions/$(instId)/guardianAccess/$(uid() + '_' + studentId)).data.guardianUid == uid()
          && get(/databases/$(database)/documents/institutions/$(instId)/guardianAccess/$(uid() + '_' + studentId)).data.studentUid == studentId;
      }
      match /guardianAccess/{accessId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.guardianUid == uid());
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['guardianUid','studentUid','studentName','inviteId','approvedBy','approvedAt'])
          && accessId == request.resource.data.guardianUid + '_' + request.resource.data.studentUid
          && request.resource.data.approvedBy == uid()
          && request.resource.data.approvedAt == request.time
          && exists(/databases/$(database)/documents/institutions/$(instId)/guardianLinks/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/institutions/$(instId)/guardianLinks/$(request.resource.data.inviteId)).data.status == 'approved'
          && get(/databases/$(database)/documents/institutions/$(instId)/guardianLinks/$(request.resource.data.inviteId)).data.guardianUid == request.resource.data.guardianUid
          && get(/databases/$(database)/documents/institutions/$(instId)/guardianLinks/$(request.resource.data.inviteId)).data.studentUid == request.resource.data.studentUid;
        allow update: if false;
        allow delete: if institutionAdmin(instId);
      }
      match /guardianLinks/{linkId} {
        allow get: if institutionAdmin(instId)
          || (signedIn() && resource.data.studentUid == uid())
          || (signedIn()
            && request.auth.token.email == resource.data.guardianEmail);
        allow list: if institutionAdmin(instId);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','guardianEmail','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'pending_verification';
        allow update: if (
          institutionAdmin(instId)
          && resource.data.status == 'awaiting_school_approval'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['approved','declined']
          && request.resource.data.reviewedBy == uid()
          && request.resource.data.reviewedAt == request.time
        ) || (
          signedIn()
          && request.auth.token.email == resource.data.guardianEmail
          && resource.data.status == 'pending_verification'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','guardianUid','claimedAt'])
          && request.resource.data.status == 'awaiting_school_approval'
          && request.resource.data.guardianUid == uid()
          && request.resource.data.claimedAt == request.time
        );
        allow delete: if false;
      }

      match /interventions/{recordId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid());
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','concern','actionPlan','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.studentUid is string;
        allow update, delete: if false;
      }
      match /academicPrograms/{recordId} {
        allow read: if institutionAdmin(instId);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['name','credits','description','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string;
        allow update, delete: if false;
      }
      match /researchProjects/{recordId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid());
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','title','supervisor','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.studentUid is string;
        allow update, delete: if false;
      }
      match /facultyPlans/{recordId} {
        allow read: if institutionAdmin(instId);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['title','week','notes','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string;
        allow update, delete: if false;
      }
      match /familyAlerts/{recordId} {
        allow read: if institutionAdmin(instId) || (signedIn() && resource.data.studentUid == uid()) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['studentUid','studentName','title','message','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.studentUid is string;
        allow update, delete: if false;
      }
      match /familyForms/{recordId} {
        allow read: if institutionAdmin(instId);
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['title','description','status','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string;
        allow update, delete: if false;
      }
      match /familyMessages/{messageId} {
        allow read: if institutionAdmin(instId) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId);
        allow update, delete: if false;
      }
      match /conferences/{conferenceId} {
        allow read: if institutionAdmin(instId) || guardianApproved(resource.data.studentUid);
        allow create: if institutionAdmin(instId);
        allow update, delete: if false;
      }
      match /auditEvents/{eventId} {
        allow read: if institutionAdmin(instId);
        allow create: if institutionAdmin(instId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /configuration/{configId} {
        allow read: if signedIn();
        allow create, update: if institutionAdmin(instId)
          && configId == 'general'
          && request.resource.data.keys().hasOnly(['level','creditSystem','calendarSystem','gpaScale','updatedBy','updatedAt'])
          && request.resource.data.level in ['high_school','college','mixed']
          && request.resource.data.creditSystem in ['carnegie','semester','quarter']
          && request.resource.data.calendarSystem in ['semester','trimester','quarter']
          && request.resource.data.gpaScale in ['4','5']
          && request.resource.data.updatedBy == uid()
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /terms/{termId} {
        allow read: if signedIn() && (institutionAdmin(instId) || get(/databases/$(database)/documents/institutions/$(instId)).data.status == 'active');
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['title','startDate','endDate','gradingScheme','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.startDate is string && request.resource.data.endDate is string
          && request.resource.data.startDate <= request.resource.data.endDate
          && request.resource.data.gradingScheme in ['standard','semester','quarter'];
        allow update, delete: if false;
      }
      match /departments/{departmentId} {
        allow read: if signedIn() && (institutionAdmin(instId) || get(/databases/$(database)/documents/institutions/$(instId)).data.status == 'active');
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['name','description','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.description is string && request.resource.data.description.size() <= 500;
        allow update, delete: if false;
      }
      match /staff/{staffUid} {
        allow read: if signedIn() && (institutionAdmin(instId) || staffUid == uid());
        allow create: if (
          institutionOwner(instId)
          || (
            signedIn()
            && staffUid == uid()
            && request.auth.token.email != null
            && exists(/databases/$(database)/documents/institutions/$(instId)/invitations/$(request.auth.token.email))
            && get(/databases/$(database)/documents/institutions/$(instId)/invitations/$(request.auth.token.email)).data.status == 'pending'
            && request.resource.data.role == get(/databases/$(database)/documents/institutions/$(instId)/invitations/$(request.auth.token.email)).data.role
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.assignedBy == get(/databases/$(database)/documents/institutions/$(instId)/invitations/$(request.auth.token.email)).data.invitedBy
          )
        )
          && request.resource.data.keys().hasOnly(['uid','email','displayName','role','assignedBy','assignedAt'])
          && request.resource.data.uid == staffUid
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.role in ['principal','assistant_principal','district_admin','registrar','counselor','department_head','instructor','staff']
          && (
            (institutionOwner(instId) && request.resource.data.assignedBy == uid())
            || (
              signedIn() && staffUid == uid()
              && request.resource.data.assignedBy == get(/databases/$(database)/documents/institutions/$(instId)/invitations/$(request.auth.token.email)).data.invitedBy
            )
          )
          && request.resource.data.assignedAt == request.time;
        allow update, delete: if institutionOwner(instId);
      }
      match /invitations/{email} {
        allow get: if institutionOwner(instId)
          || (signedIn() && request.auth.token.email == email);
        allow list: if institutionOwner(instId);
        allow create, update: if institutionOwner(instId)
          && request.resource.data.keys().hasOnly(['email','role','status','invitedBy','invitedAt'])
          && request.resource.data.email == email
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['principal','assistant_principal','district_admin','registrar','counselor','department_head','instructor','staff']
          && request.resource.data.invitedBy == uid()
          && request.resource.data.invitedAt == request.time;
        allow update: if signedIn()
          && request.auth.token.email == email
          && resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/institutions/$(instId)/staff/$(uid()))
          && get(/databases/$(database)/documents/institutions/$(instId)/staff/$(uid())).data.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == uid()
          && request.resource.data.acceptedAt == request.time;
        allow delete: if institutionOwner(instId);
      }

      match /offerings/{offeringId} {
        allow read: if signedIn() && (resource.data.published == true || institutionAdmin(instId));
        allow create: if institutionAdmin(instId)
          && request.resource.data.keys().hasOnly(['courseId','title','code','term','description','openDate','closeDate','openAt','closeAt','published','createdBy','createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.courseId is string
          && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
          && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.catalogCourse == true
          && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.catalogPublished == true
          && request.resource.data.title == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.title
          && request.resource.data.code == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.code
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 24
          && request.resource.data.term is string
          && request.resource.data.term.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.openDate is string
          && request.resource.data.closeDate is string
          && request.resource.data.openAt is timestamp
          && request.resource.data.closeAt is timestamp
          && request.resource.data.openAt < request.resource.data.closeAt
          && request.resource.data.published == true
          && request.resource.data.createdAt == request.time;
        allow update: if institutionAdmin(instId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['period','room','capacity','instructorUid','instructorName','scheduledBy','scheduledAt'])
          && request.resource.data.period is string && request.resource.data.period.size() <= 80
          && request.resource.data.room is string && request.resource.data.room.size() <= 100
          && request.resource.data.capacity is int && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
          && request.resource.data.instructorUid is string
          && request.resource.data.instructorName is string
          && request.resource.data.scheduledBy == uid()
          && request.resource.data.scheduledAt == request.time;
        allow delete: if false;
      }

      match /requests/{requestId} {
        allow get, list: if signedIn()
          && (institutionAdmin(instId) || resource.data.studentUid == uid());
        allow create: if signedIn()
          && userData().role == 'student'
          && exists(/databases/$(database)/documents/institutions/$(instId)/members/$(uid()))
          && get(/databases/$(database)/documents/institutions/$(instId)/members/$(uid())).data.status == 'active'
          && request.resource.data.keys().hasOnly(['offeringId','studentUid','studentName','status','createdAt'])
          && request.resource.data.studentUid == uid()
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && requestId == request.resource.data.offeringId + '_' + uid()
          && exists(/databases/$(database)/documents/institutions/$(instId)/offerings/$(request.resource.data.offeringId))
          && get(/databases/$(database)/documents/institutions/$(instId)/offerings/$(request.resource.data.offeringId)).data.published == true
          && request.time >= get(/databases/$(database)/documents/institutions/$(instId)/offerings/$(request.resource.data.offeringId)).data.openAt
          && request.time < get(/databases/$(database)/documents/institutions/$(instId)/offerings/$(request.resource.data.offeringId)).data.closeAt;
        allow update: if institutionAdmin(instId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['approved','declined']
          && request.resource.data.reviewedBy == uid()
          && request.resource.data.reviewedAt == request.time;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
