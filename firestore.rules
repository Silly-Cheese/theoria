rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isInstructor() {
      return signedIn() && userData().role == 'instructor';
    }

    function isSystemOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.uid == uid()
        && get(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function ownerRecordMatchesUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.uid == uid();
    }

    function ownerEmailMatchesUser() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.email == request.auth.token.email;
    }

    function claimingSystemOwner() {
      return signedIn()
        && !ownerExists()
        && existsAfter(/databases/$(database)/documents/system/owner)
        && getAfter(/databases/$(database)/documents/system/owner).data.uid == uid()
        && getAfter(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function reclaimingSystemOwner() {
      return ownerEmailMatchesUser()
        && existsAfter(/databases/$(database)/documents/system/owner)
        && getAfter(/databases/$(database)/documents/system/owner).data.uid == uid()
        && getAfter(/databases/$(database)/documents/system/owner).data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/system/owner).data.confirmed == true;
    }

    function courseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function courseIsPublishedCatalog(courseId) {
      return ('catalogCourse' in courseData(courseId))
        && ('catalogPublished' in courseData(courseId))
        && courseData(courseId).catalogCourse == true
        && courseData(courseId).catalogPublished == true;
    }

    function canUseCourseAsInstructor(courseId) {
      return isInstructor()
        && (
          courseOwner(courseId)
          || isSystemOwner()
          || courseIsPublishedCatalog(courseId)
        );
    }

    function canManageCourse(courseId) {
      return isSystemOwner()
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in courseData(courseId))
            || courseData(courseId).catalogCourse != true
          )
        );
    }

    function isInstructorAfter() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.role == 'instructor';
    }

    function ownerExists() {
      return exists(/databases/$(database)/documents/system/owner);
    }

    function ownerAfterMatchesUser() {
      return getAfter(/databases/$(database)/documents/system/owner).data.uid == uid();
    }

    function courseOwner(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == uid();
    }

    function sectionOwner(sectionId) {
      return signedIn()
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionOwnerAfter(sectionId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/sections/$(sectionId)).data.ownerId == uid();
    }

    function sectionStaff(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/staff/$(uid()));
    }

    function sectionStaffRole(sectionId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)/staff/$(uid())).data.role;
    }

    function sectionAcademicManager(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) == 'coordinator'
        );
    }

    function sectionCourseworkManager(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) in ['coordinator', 'teaching_assistant']
        );
    }

    function sectionGrader(sectionId) {
      return sectionOwner(sectionId)
        || (
          sectionStaff(sectionId)
          && sectionStaffRole(sectionId) in ['coordinator', 'teaching_assistant', 'grader']
        );
    }

    function sectionMember(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function sectionMemberAfter(sectionId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/sections/$(sectionId)/members/$(uid()));
    }

    function sectionData(sectionId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)).data;
    }

    function sectionRequiresEntranceExam(sectionId) {
      return (
          ('entranceExamRequired' in sectionData(sectionId))
          && sectionData(sectionId).entranceExamRequired == true
        )
        || (
          ('entranceExamRequired' in courseData(sectionData(sectionId).courseId))
          && courseData(sectionData(sectionId).courseId).entranceExamRequired == true
        );
    }

    function entranceCandidate(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid()));
    }

    function entranceCandidatePassed(sectionId) {
      return entranceCandidate(sectionId)
        && get(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid())).data.status == 'passed'
        && get(/databases/$(database)/documents/sections/$(sectionId)/entranceCandidates/$(uid())).data.assessmentId == sectionData(sectionId).entranceAssessmentId;
    }

    function assessmentData(assessmentId) {
      return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
    }

    function assessmentOwner(assessmentId) {
      return signedIn() && assessmentData(assessmentId).ownerId == uid();
    }

    function assessmentEntranceCandidate(assessmentId) {
      return signedIn()
        && ('entranceExam' in assessmentData(assessmentId))
        && assessmentData(assessmentId).entranceExam == true
        && assessmentData(assessmentId).sectionId != ''
        && ('entranceAssessmentId' in sectionData(assessmentData(assessmentId).sectionId))
        && sectionData(assessmentData(assessmentId).sectionId).entranceAssessmentId == assessmentId
        && entranceCandidate(assessmentData(assessmentId).sectionId);
    }

    function assessmentMember(assessmentId) {
      return signedIn()
        && assessmentData(assessmentId).sectionId != ''
        && (
          sectionMember(assessmentData(assessmentId).sectionId)
          || assessmentEntranceCandidate(assessmentId)
        );
    }

    function assessmentOpen(assessmentId) {
      return assessmentMember(assessmentId)
        && assessmentData(assessmentId).status == 'Published'
        && (
          assessmentData(assessmentId).opensAt == null
          || request.time >= assessmentData(assessmentId).opensAt
        )
        && (
          assessmentData(assessmentId).closesAt == null
          || request.time <= assessmentData(assessmentId).closesAt
        );
    }

    function hasActiveSubmission(assessmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
        && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress';
    }

    function gradingSelectionOpen(sectionId) {
      return sectionMember(sectionId)
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionOpen == true
        && (
          get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline == null
          || request.time <= get(/databases/$(database)/documents/sections/$(sectionId)).data.gradingPolicy.selectionDeadline
        );
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.role in ['student', 'instructor'];
      allow read: if isSelf(userId);
      allow update: if isSelf(userId)
        && (
          request.resource.data.role == resource.data.role
          || (
            request.resource.data.role == 'instructor'
            && (
              ownerRecordMatchesUser()
              || claimingSystemOwner()
              || reclaimingSystemOwner()
            )
          )
        );
      allow delete: if false;

      match /enrollments/{sectionId} {
        allow read: if isSelf(userId);
        allow delete: if isSelf(userId) || sectionOwner(sectionId);
        allow create: if isSelf(userId) && sectionMemberAfter(sectionId);
        allow update: if (
          isSelf(userId) && sectionMemberAfter(sectionId)
        ) || sectionOwner(sectionId);
      }

      match /staffSections/{sectionId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if sectionOwner(sectionId);
      }
    }

    match /directory/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == uid();
      allow delete: if isSelf(userId);
    }

    match /academicAccess/{userId} {
      allow read: if isSelf(userId) || isInstructor();
      allow create, update: if isInstructor()
        && request.resource.data.studentId == userId;
      allow delete: if isSystemOwner();
    }

    match /system/{systemDoc} {
      allow read: if signedIn();
      allow create: if systemDoc == 'owner'
        && !ownerExists()
        && isInstructorAfter()
        && request.resource.data.uid == uid()
        && request.resource.data.confirmed == true;
      allow update: if systemDoc == 'owner'
        && request.resource.data.confirmed == true
        && (
          (
            ownerRecordMatchesUser()
            && request.resource.data.uid == resource.data.uid
          )
          || (
            ownerEmailMatchesUser()
            && request.resource.data.uid == uid()
            && request.resource.data.email == request.auth.token.email
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'displayName',
          'email',
          'confirmed',
          'confirmedAt',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && (
          !('catalogCourse' in request.resource.data)
          || request.resource.data.catalogCourse != true
          || isSystemOwner()
        );
      allow update: if isSystemOwner()
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in resource.data)
            || resource.data.catalogCourse != true
          )
          && (
            !('catalogCourse' in request.resource.data)
            || request.resource.data.catalogCourse != true
          )
        )
        || (
          isInstructor()
          && !('ownerId' in resource.data)
          && request.resource.data.ownerId == uid()
          && (
            !('catalogCourse' in request.resource.data)
            || request.resource.data.catalogCourse != true
          )
        );
      allow delete: if isSystemOwner()
        || (
          courseOwner(courseId)
          && (
            !('catalogCourse' in resource.data)
            || resource.data.catalogCourse != true
          )
        );

      match /units/{unitId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageCourse(courseId);

        match /topics/{topicId} {
          allow read: if signedIn();
          allow create, update, delete: if canManageCourse(courseId);
        }
      }

      match /competencies/{competencyId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /items/{itemId} {
        allow read: if isSystemOwner()
          || courseOwner(courseId)
          || (
            isInstructor()
            && courseIsPublishedCatalog(courseId)
          );
        allow create, update, delete: if canManageCourse(courseId);

        match /versions/{versionId} {
          allow read: if isSystemOwner()
            || courseOwner(courseId)
            || (
              isInstructor()
              && courseIsPublishedCatalog(courseId)
            );
          allow create: if canManageCourse(courseId);
          allow update, delete: if false;
        }
      }

      match /approvals/{userId} {
        allow read: if isSelf(userId) || isInstructor();
        allow create, update, delete: if isInstructor();
      }

      match /auditLog/{eventId} {
        allow read: if canManageCourse(courseId);
        allow create: if canManageCourse(courseId);
        allow update, delete: if false;
      }
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && canUseCourseAsInstructor(request.resource.data.courseId);
      allow update, delete: if sectionOwner(sectionId);

      match /members/{userId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || isSelf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.userId == uid()
          && request.resource.data.role == 'student'
          && get(/databases/$(database)/documents/sections/$(sectionId)).data.joinOpen == true
          && (
            !sectionRequiresEntranceExam(sectionId)
            || entranceCandidatePassed(sectionId)
          );
        allow update: if sectionAcademicManager(sectionId);
        allow delete: if sectionAcademicManager(sectionId) || isSelf(userId);
      }

      match /staff/{userId} {
        allow read: if sectionOwner(sectionId) || isSelf(userId) || sectionStaff(sectionId);
        allow create, update, delete: if sectionOwner(sectionId);
      }

      match /enrollmentHistory/{eventId} {
        allow read, create: if sectionOwner(sectionId);
        allow update, delete: if false;
      }

      match /auditLog/{eventId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId);
        allow create: if sectionOwner(sectionId) || sectionStaff(sectionId);
        allow update, delete: if false;
      }

      match /entranceCandidates/{userId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || isSelf(userId);
        allow create: if isSelf(userId)
          && sectionData(sectionId).joinOpen == true
          && request.resource.data.userId == uid()
          && request.resource.data.status == 'pending'
          && request.resource.data.assessmentId == sectionData(sectionId).entranceAssessmentId;
        allow update: if sectionAcademicManager(sectionId);
        allow delete: if sectionAcademicManager(sectionId) || isSelf(userId);
      }

      match /assignments/{assignmentId} {
        allow read: if sectionOwner(sectionId)
          || sectionStaff(sectionId)
          || (sectionMember(sectionId) && resource.data.status == 'Published');
        allow create, update, delete: if sectionCourseworkManager(sectionId);

        match /submissions/{studentId} {
          allow read: if sectionGrader(sectionId) || isSelf(studentId);
          allow create: if isSelf(studentId)
            && sectionMember(sectionId)
            && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
            && request.resource.data.studentId == uid()
            && request.resource.data.status in ['draft', 'submitted'];
          allow update: if sectionGrader(sectionId)
            || (
              isSelf(studentId)
              && sectionMember(sectionId)
              && get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.status == 'Published'
              && request.resource.data.studentId == uid()
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.status in ['draft', 'submitted']
              && (
                resource.data.status == 'draft'
                || get(/databases/$(database)/documents/sections/$(sectionId)/assignments/$(assignmentId)).data.allowResubmission == true
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'responseText',
                'responseUrl',
                'status',
                'submittedAt',
                'updatedAt',
                'studentName'
              ])
            );
          allow delete: if sectionGrader(sectionId)
            || (
              isSelf(studentId)
              && resource.data.status == 'draft'
            );
        }
      }

      match /resources/{resourceId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /grades/{gradeId} {
        allow read: if sectionGrader(sectionId)
          || (sectionMember(sectionId) && resource.data.studentId == uid());
        allow create, update, delete: if sectionGrader(sectionId);
      }

      match /assessmentRefs/{assessmentId} {
        allow read: if sectionOwner(sectionId) || sectionStaff(sectionId) || sectionMember(sectionId);
        allow create, update, delete: if sectionCourseworkManager(sectionId);
      }

      match /gradingPathways/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update: if sectionAcademicManager(sectionId)
          || (
            isSelf(userId)
            && gradingSelectionOpen(sectionId)
            && request.resource.data.studentId == uid()
            && request.resource.data.pathway in ['examination', 'composite']
          );
        allow delete: if sectionAcademicManager(sectionId);
      }

      match /assessmentGrades/{gradeId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create, update, delete: if sectionGrader(sectionId);
      }

      match /mastery/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /academicRecords/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /portfolios/{userId} {
        allow read: if sectionGrader(sectionId) || isSelf(userId);
        allow create, update, delete: if sectionAcademicManager(sectionId);
      }

      match /appeals/{appealId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create: if sectionMember(sectionId)
          && request.resource.data.studentId == uid()
          && request.resource.data.status == 'Pending';
        allow update, delete: if sectionAcademicManager(sectionId);
      }

      match /recordHistory/{historyId} {
        allow read: if sectionGrader(sectionId)
          || (
            sectionMember(sectionId)
            && resource.data.studentId == uid()
          );
        allow create: if sectionAcademicManager(sectionId);
        allow update: if false;
        allow delete: if sectionAcademicManager(sectionId);
      }
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && sectionOwnerAfter(request.resource.data.sectionId);
      allow update: if isInstructor()
        && sectionOwner(resource.data.sectionId)
        && request.resource.data.sectionId == resource.data.sectionId;
      allow delete: if isInstructor()
        && sectionOwner(resource.data.sectionId);
    }

    match /assessments/{assessmentId} {
      allow read: if (
          signedIn()
          && resource.data.ownerId == uid()
        )
        || (
          signedIn()
          && resource.data.sectionId != ''
          && (
            sectionStaff(resource.data.sectionId)
            || exists(/databases/$(database)/documents/sections/$(resource.data.sectionId)/members/$(uid()))
            || assessmentEntranceCandidate(assessmentId)
          )
          && resource.data.status in ['Published', 'Closed']
        );
      allow create: if isInstructor()
        && request.resource.data.ownerId == uid()
        && canUseCourseAsInstructor(request.resource.data.courseId)
        && (
          request.resource.data.sectionId == ''
          || sectionCourseworkManager(request.resource.data.sectionId)
        );
      allow update: if (
          assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionCourseworkManager(assessmentData(assessmentId).sectionId)
          )
        )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.sectionId == resource.data.sectionId;
      allow delete: if assessmentOwner(assessmentId)
        || (
          assessmentData(assessmentId).sectionId != ''
          && sectionAcademicManager(assessmentData(assessmentId).sectionId)
        );

      match /questions/{questionId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            signedIn()
            && assessmentData(assessmentId).sectionId != ''
            && assessmentMember(assessmentId)
            && exists(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid()))
            && get(/databases/$(database)/documents/assessments/$(assessmentId)/submissions/$(uid())).data.status == 'in_progress'
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }

      match /keys/{questionId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
        allow create, update, delete: if assessmentOwner(assessmentId);
      }

      match /submissions/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || isSelf(studentId);

        allow create: if assessmentOwner(assessmentId)
          || (
            isSelf(studentId)
            && assessmentOpen(assessmentId)
            && request.resource.data.studentId == uid()
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasOnly([
              'studentId',
              'candidateNumber',
              'status',
              'startedAt',
              'updatedAt',
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'questionOrder',
              'acknowledgedAt',
              'accommodationsApplied'
            ])
          );

        allow update: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            isSelf(studentId)
            && assessmentMember(assessmentId)
            && resource.data.status == 'in_progress'
            && request.resource.data.studentId == uid()
            && request.resource.data.candidateNumber == resource.data.candidateNumber
            && request.resource.data.status in ['in_progress', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'answers',
              'marked',
              'currentIndex',
              'elapsedSeconds',
              'status',
              'submittedAt',
              'updatedAt'
            ])
          );

        allow delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionAcademicManager(assessmentData(assessmentId).sectionId)
          );

        match /events/{eventId} {
          allow read: if assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionGrader(assessmentData(assessmentId).sectionId)
            )
            || isSelf(studentId);
          allow create: if isSelf(studentId)
            && assessmentMember(assessmentId)
            && request.resource.data.studentId == uid();
          allow update: if false;
          allow delete: if assessmentOwner(assessmentId)
            || (
              assessmentData(assessmentId).sectionId != ''
              && sectionAcademicManager(assessmentData(assessmentId).sectionId)
            );
        }
      }

      match /results/{studentId} {
        allow read: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          )
          || (
            isSelf(studentId)
            && resource.data.complete == true
          );
        allow create, update, delete: if assessmentOwner(assessmentId)
          || (
            assessmentData(assessmentId).sectionId != ''
            && sectionGrader(assessmentData(assessmentId).sectionId)
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
