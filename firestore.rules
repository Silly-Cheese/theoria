rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && userData().role == role; }

    match /users/{uid} {
      allow create: if isSelf(uid) && request.resource.data.role in ['student', 'instructor'];
      allow read: if isSelf(uid);
      allow update: if isSelf(uid) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole('instructor');
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole('instructor');
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow update, delete: if hasRole('instructor') || isSelf(uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
